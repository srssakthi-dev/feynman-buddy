# Explaino runs local models; no cloud API key is required.
# These variables are optional. Set them in the shell before startup if needed.
# By default, private sessions are stored in this repository's ignored data/ folder.
# The FEYNMAN_* names remain for compatibility with the original repository.
# FEYNMAN_DATA_DIR=C:\\path\\to\\private-data
# FEYNMAN_API_TARGET=http://127.0.0.1:8001
# STUDY_MODEL=qwen3.5:4b
# WHISPER_MODEL_PATH=C:\\Users\\you\\.cache\\whisper\\base.pt
